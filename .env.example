# =============================================================================
# OPEN SCOUTS - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Required)
# Get these from: https://supabase.com/dashboard/project/<your-project>/settings/api
# -----------------------------------------------------------------------------

# Your Supabase project URL (format: https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Anonymous/Public Key (safe to expose in browser)
# Found in: Project Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (KEEP SECRET - server-side only)
# Found in: Project Settings → API → Project API keys → service_role
# WARNING: This key bypasses Row Level Security - never expose in browser
SUPABASE_SERVICE_ROLE_KEY=

# Direct database connection URL
# Found in: Project Settings → Database → Connection string → URI
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# -----------------------------------------------------------------------------
# OPENAI CONFIGURATION (Required)
# Get your API key from: https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------

# OpenAI API Key for AI agent and embeddings
# Used by the Next.js app for scout configuration chat
OPENAI_API_KEY=

# OpenAI Base URL (Optional - for proxy/custom endpoints)
# Default: https://api.openai.com/v1
# Set this if you're using a proxy or custom OpenAI-compatible endpoint
# Example: https://your-proxy.com/v1 or https://openrouter.ai/api/v1
OPENAI_BASE_URL=

# OpenAI Model (Optional - specify which model to use)
# Default: gpt-4o-mini
# For OpenRouter: openai/gpt-4o-mini, openai/gpt-4o, openai/gpt-5, anthropic/claude-3.5-sonnet
# For OpenAI: gpt-4o-mini, gpt-4o, gpt-4-turbo
OPENAI_MODEL=

# OpenAI Embedding Model (Optional - specify which embedding model to use)
# Default: text-embedding-3-small
# Used for generating embeddings for deduplication detection
# Note: The proxy/custom endpoint must support the embeddings API
# If your OPENAI_BASE_URL doesn't support embeddings, you may need to:
#   1. Use official OpenAI API (https://api.openai.com/v1)
#   2. Or use a compatible embedding model supported by your proxy
# Official OpenAI embedding models: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
OPENAI_EMBEDDING_MODEL=

# OpenAI Embedding Base URL (Optional - separate endpoint for embeddings)
# Default: uses OPENAI_BASE_URL
# Set this if you want to use a different API endpoint for embeddings
# Example: Use official OpenAI for embeddings while using proxy for chat
OPENAI_EMBEDDING_BASE_URL=

# OpenAI Embedding API Key (Optional - separate key for embeddings)
# Default: uses OPENAI_API_KEY
# Set this if you want to use a different API key for embeddings
OPENAI_EMBEDDING_API_KEY=

# -----------------------------------------------------------------------------
# FIRECRAWL CONFIGURATION (Required)
# Get your API key from: https://www.firecrawl.dev/app/api-keys
# -----------------------------------------------------------------------------

# Firecrawl API Key for web scraping and search
#
# Two usage modes:
# 1. Standard Key: Your regular Firecrawl API key (fc-xxx)
#    - All users share this key
#    - Simple setup, good for personal projects
#
# 2. Partner Key: Special partner integration key
#    - Automatically creates per-user API keys on signup
#    - Better usage tracking and isolation
#    - Contact Firecrawl to become a partner
#
FIRECRAWL_API_KEY=

# -----------------------------------------------------------------------------
# RESEND CONFIGURATION (Optional - for email notifications)
# Get your API key from: https://resend.com/api-keys
# Verify your domain at: https://resend.com/domains
# -----------------------------------------------------------------------------

# Resend API Key for sending email notifications
# Leave empty to disable email notifications
RESEND_API_KEY=

# From email address for notifications (requires verified domain)
# Format: "Display Name <email@yourdomain.com>"
# Default: "Open Scouts <onboarding@resend.dev>" (Resend sandbox, limited to account owner email)
# After verifying your domain, set this to use your domain (e.g., "Open Scouts <scouts@yourdomain.com>")
RESEND_FROM_EMAIL=

# -----------------------------------------------------------------------------
# SITE CONFIGURATION (Optional)
# -----------------------------------------------------------------------------

# Your production site URL (used for OAuth redirects, OG images, etc.)
# For local development, this can be left empty or set to http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Automatically set by Vercel deployments (optional)
# NEXT_PUBLIC_VERCEL_URL=

# =============================================================================
# EDGE FUNCTION SECRETS (Set via Supabase CLI)
# =============================================================================
# These are set separately using: npx supabase secrets set KEY=value
#
# Required for scout execution:
#   npx supabase secrets set OPENAI_API_KEY=sk-proj-...
#   npx supabase secrets set FIRECRAWL_API_KEY=fc-...
#
# Optional for custom OpenAI endpoint:
#   npx supabase secrets set OPENAI_BASE_URL=https://your-proxy.com/v1
#
# Optional for custom model:
#   npx supabase secrets set OPENAI_MODEL=openai/gpt-5
#
# Optional for email notifications:
#   npx supabase secrets set RESEND_API_KEY=re_...
#   npx supabase secrets set RESEND_FROM_EMAIL="Open Scouts <scouts@yourdomain.com>"
# =============================================================================

# =============================================================================
# GOOGLE OAUTH SETUP (Configured in Supabase Dashboard, not here)
# =============================================================================
# Google OAuth is configured directly in the Supabase Dashboard:
# 1. Go to: https://console.cloud.google.com/
# 2. Create OAuth 2.0 credentials
# 3. Set redirect URI: https://<project-ref>.supabase.co/auth/v1/callback
# 4. In Supabase Dashboard → Authentication → Providers → Google
# 5. Add your Client ID and Client Secret
#
# See README.md for detailed instructions
# =============================================================================
